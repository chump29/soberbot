{
  "name": "soberbot",
  "version": "1.0.0",
  "private": true,
  "description": "SoberBot for Discord",
  "keywords": [
    "sober",
    "sobriety",
    "time",
    "tracker",
    "counter",
    "substance",
    "discord",
    "bot"
  ],
  "homepage": "https://github.com/chump29/soberbot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/soberbot.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "check": "bunx --bun depcheck --ignores=\"@types/*,bun,bun:*,lcov-total,rimraf\" || :",
    "dev": "bun --watch run index.ts",
    "preinstall": "bunx --bun only-allow bun",
    "lint": "bun run scan && bun run lint:spell && bun run lint:biome && bun run lint:env && bun run lint:ts",
    "lint:biome": "bun run --bun biome check --write --verbose --reporter=default --reporter=github --error-on-warnings",
    "lint:biome:ci": "bun run --bun biome ci --verbose --reporter=default --reporter=github --error-on-warnings",
    "lint:env": "bun run --bun dotenv-linter check .",
    "lint:spell": "bun run --bun cspell --dot --verbose .",
    "lint:ts": "bun run --bun tsc",
    "prepare": "husky",
    "prod": "bun run index.ts",
    "scan": "bun audit && bun run --bun cve-lite --check-overrides",
    "sql": "drizzle-kit generate",
    "test": "bun test --isolate --dots --bail",
    "test:coverage": "bun test --isolate --dots --coverage --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --bail",
    "test:coverage:full": "bun test --isolate --coverage --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --bail",
    "test:full": "bun test --isolate --bail",
    "updates": "bunx --bun npm-check-updates --dep overrides,prod,dev --cooldown 0 --install never --packageManager bun --peer"
  },
  "lint-staged": {
    "*.{json,ts}": "bun run --bun biome ci --no-errors-on-unmatched --error-on-warnings",
    ".env*": "bun run --bun dotenv-linter check"
  },
  "overrides": {
    "@biomejs/biome": "2.5.11",
    "@types/bun": "1.4.0",
    "@types/node": "26.4.0",
    "cspell": "10.2.0",
    "cve-lite-cli": "1.31.0",
    "globals": "17.11.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@jarrodek/pluralize": "^1.0.2",
    "@postfmly/checkrate": "^1.0.12",
    "@postfmly/logger": "^1.0.30",
    "@postfmly/logoserver": "^1.2.5",
    "@postfmly/types": "^1.0.2",
    "dayjs": "^1.11.23",
    "discord.js": "^14.27.0",
    "drizzle-orm": "1.0.0-rc.4",
    "envalid": "^8.2.0",
    "title-case": "^4.3.2",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@postfmly/config": "^1.4.55",
    "drizzle-kit": "1.0.0-rc.4",
    "husky": "^9.1.7",
    "lcov-total": "^2.1.1",
    "lint-staged": "^17.4.1",
    "rimraf": "^6.1.3"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "~1.4.0"
  },
  "engineStrict": true,
  "patchedDependencies": {
    "@jarrodek/pluralize@1.0.2": "patches/@jarrodek%2Fpluralize@1.0.2.patch"
  }
}
